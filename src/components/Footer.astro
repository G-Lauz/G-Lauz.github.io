---
import { site, footerLinks } from '../data/site';
---

<footer class="mt-auto w-full border-t border-surface-variant bg-background py-12">
    <div class="mx-auto flex max-w-max-width flex-col items-center justify-between gap-gutter px-margin-mobile md:flex-row md:px-margin-desktop">
        <div class="flex flex-col items-center gap-2 md:items-start">
          <span class="font-label text-label-md text-primary">{site.name}</span>
          <span class="font-label text-label-sm text-secondary">&copy; 2026 {site.name}. All rights reserved.</span>
        </div>

        <nav class="flex flex-wrap justify-center gap-6 font-label text-label-sm" aria-label="Academic profiles">
          {footerLinks.map((link) => (
            <a class="text-secondary transition-colors duration-200 hover:text-primary" href={link.href}>
              {link.label}
            </a>
          ))}
        </nav>
    </div>
</footer>
