---
import Head from "@components/Head.astro";
import Header from "@components/Header";
import Footer from "@components/Footer.astro";

import type { ActiveSection } from "@data/site";

import "@styles/global.css";

interface Props {
  title: string;
  description: string;
  activeSection: ActiveSection;
}

const { title, description, activeSection } = Astro.props as Props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <Header activeSection={activeSection} client:load />
    <slot />
    <Footer />
  </body>
</html>
